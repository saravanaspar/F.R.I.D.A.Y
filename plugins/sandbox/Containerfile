# Multi-architecture digest resolved from the official Node image index. Dependabot
# can update this pin deliberately; sandbox builds must never float underneath a
# detached execution that was already approved.
FROM docker.io/library/node:22-bookworm@sha256:0557ac14e0d45d02ed563067b82856ca5e7aa3437fa28d98d4350ea9c3d9494a

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       ca-certificates \
       curl \
       git \
       jq \
       pkg-config \
       python3 \
       python3-pip \
       python3-venv \
       python3-ipykernel \
       python3-dill \
       ripgrep \
       unzip \
       zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
