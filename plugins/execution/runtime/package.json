{
  "name": "@friday/execution",
  "version": "1.0.3",
  "description": "FRIDAY persistent Python kernel and process execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resource-access": {
      "types": "./dist/resource-access.d.ts",
      "import": "./dist/resource-access.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "setup:python": "node scripts/setup-python.mjs",
    "test": "vitest run --config vitest.config.ts --configLoader runner --no-cache"
  },
  "dependencies": {
    "@friday/operational-errors": "1.0.3",
    "uuid": "^14.0.0",
    "zeromq": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
