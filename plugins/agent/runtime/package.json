{
  "name": "@friday/agent",
  "version": "1.0.2",
  "description": "FRIDAY generic agent loop and agent state",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model-access": {
      "types": "./dist/model-access.d.ts",
      "import": "./dist/model-access.js"
    },
    "./event-stream": {
      "types": "./dist/event-stream.d.ts",
      "import": "./dist/event-stream.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts --configLoader runner --no-cache"
  },
  "dependencies": {
    "@friday/operational-errors": "1.0.2",
    "typebox": "^1.3.9"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
