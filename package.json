{
  "name": "friday",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "dev": "tsx src/runtime.ts",
    "friday": "tsx src/friday.ts",
    "test": "npm run check:architecture && npm run check:packaging && vitest run --config vitest.config.ts && node scripts/workspace-packages.mjs test",
    "typecheck": "npm run check:architecture && npm run check:packaging && tsc --noEmit",
    "predev": "npm run build:workspaces",
    "prefriday": "npm run build:workspaces",
    "prebuild:binary": "npm run generate:builtin-plugins && npm run build:workspaces",
    "pretest": "npm run build:workspaces",
    "pretypecheck": "npm run build:workspaces",
    "preverify": "npm run build:workspaces",
    "build:workspaces": "node scripts/workspace-packages.mjs build",
    "test:workspaces": "npm run build:workspaces && node scripts/workspace-packages.mjs test",
    "verify": "npm run check:architecture && npm run check:packaging && tsc --noEmit && npm run check:silent-failures && npm run check:models && vitest run --config vitest.config.ts && node scripts/workspace-packages.mjs test",
    "check:packaging": "node scripts/workspace-packages.mjs check && node scripts/workspace-packages.mjs check-node-modules && node scripts/binary-assets.mjs check",
    "build:sandbox-image": "node scripts/build-sandbox-image.mjs",
    "setup:execution-python": "npm run setup:python --workspace @friday/execution",
    "setup:whatsapp": "npm run setup:whatsapp --workspace @friday/channels",
    "onboard": "tsx src/friday.ts setup",
    "build:binary": "node scripts/build-binary.mjs",
    "package:binary": "npm run build:binary && node scripts/package-release-binary.mjs",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "check:silent-failures": "node scripts/check-no-silent-failures.mjs",
    "generate-models": "node --experimental-strip-types scripts/generate-models.ts",
    "check:models": "node --experimental-strip-types scripts/generate-models.ts --check",
    "check:architecture": "node scripts/check-plugin-boundaries.mjs && node scripts/generate-builtin-plugins.mjs --check",
    "generate:builtin-plugins": "node scripts/generate-builtin-plugins.mjs",
    "clean:workspace-node-modules": "node scripts/workspace-packages.mjs clean-node-modules",
    "check:workspace-node-modules": "node scripts/workspace-packages.mjs check-node-modules"
  },
  "dependencies": {
    "@friday/operational-errors": "0.0.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^24.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*",
    "plugins/*/runtime"
  ]
}
