[Unit]
Description=FRIDAY personal agent
# Bound restart storms while retaining automatic recovery from isolated failures.
StartLimitIntervalSec=300
StartLimitBurst=10
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# FRIDAY performs verified two-process handoffs during self-improvement. Keep the
# unit active while either predecessor or successor remains in this cgroup.
ExitType=cgroup
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=-%h/FRIDAY-workspace
ExecStart=/usr/bin/env friday
Restart=on-failure
RestartSec=5
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=45

[Install]
WantedBy=default.target
