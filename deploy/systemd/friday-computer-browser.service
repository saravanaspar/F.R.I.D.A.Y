[Unit]
Description=F.R.I.D.A.Y native X11 browser supervisor
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
Environment=PATH=%h/.local/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
Environment=FRIDAY_COMPUTER_CDP_PORT=9222
ExecStart=/bin/sh -lc 'bin="${FRIDAY_COMPUTER_BROWSER_BIN:-${FRIDAY_CHROMIUM_BIN:-}}"; if [ -z "$bin" ]; then for candidate in brave-browser-stable brave-browser google-chrome-stable google-chrome chromium chromium-browser; do if command -v "$candidate" >/dev/null 2>&1; then bin="$candidate"; break; fi; done; fi; if [ -z "$bin" ]; then echo "No supported Chromium-family browser found" >&2; exit 127; fi; profile="${FRIDAY_COMPUTER_BROWSER_PROFILE_DIR:-${FRIDAY_HOME:-$HOME/.friday}/computer/browser-profile}"; mkdir -p "$profile"; chmod 700 "$profile"; exec "$bin" --ozone-platform=x11 --remote-debugging-address=127.0.0.1 --remote-debugging-port="$FRIDAY_COMPUTER_CDP_PORT" --user-data-dir="$profile" --no-first-run --no-default-browser-check --no-startup-window'
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=graphical-session.target
