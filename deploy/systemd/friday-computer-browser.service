[Unit]
Description=F.R.I.D.A.Y managed Chromium CDP fallback
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
Environment=PATH=%h/.local/bin:/snap/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env friday computer-browser-supervisor
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=graphical-session.target
